{
  "name": "crosscampus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-crosscampus --only firestore \"node --test tests/firebase/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start --project demo-crosscampus --only auth,firestore",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "deploy:firebase": "firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "prettier": "3.9.10"
  },
  "type": "module",
  "packageManager": "npm@11.6.2",
  "description": "Cross-school project teams, from first proposal to first sprint."
}
